@model List<QuizIA.Logica.Dtos.QuizResumen>
@{ ViewData["Title"] = "Mis quizzes"; }

<h1>Mis quizzes</h1>

@if (TempData["Exito"] is string exito)
{
    <div class="alert alert-success">@exito</div>
}

@if (Model.Count == 0)
{
    <p class="text-muted">Todavía no tenés quizzes.</p>
    <a asp-action="Crear" class="btn btn-primary">Crear mi primer quiz</a>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Título</th>
                <th>Creado</th>
                <th>Preguntas</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var q in Model)
            {
                <tr>
                    <td>@q.Titulo</td>
                    <td>@q.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@q.CantidadPreguntas</td>
                    <td class="text-end">
                        <a asp-action="Rendir" asp-route-id="@q.Id" class="btn btn-sm btn-primary">Rendir</a>
                        <form asp-action="Borrar" asp-route-id="@q.Id" method="post" class="d-inline"
                              onsubmit="return confirm('¿Borrar este quiz? No se puede deshacer.');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Borrar</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <a asp-action="Crear" class="btn btn-outline-primary">Crear otro quiz</a>
}
